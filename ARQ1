-- ฟังก์ชันสร้างปุ่ม Toggle (เปิด/ปิด)
local function CreateToggle(text, callback)
    local ToggleButton = Instance.new("TextButton")
    local ButtonCorner = Instance.new("UICorner")
    local StatusLabel = Instance.new("TextLabel")
    local enabled = false

    ToggleButton.Name = text
    ToggleButton.Parent = Container
    ToggleButton.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    ToggleButton.Size = UDim2.new(1, -10, 0, 38)
    ToggleButton.Font = Enum.Font.GothamMedium
    ToggleButton.Text = "  " .. text
    ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleButton.TextSize = 14.000
    ToggleButton.TextXAlignment = Enum.TextXAlignment.Left

    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = ToggleButton

    StatusLabel.Name = "Status"
    StatusLabel.Parent = ToggleButton
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Position = UDim2.new(0.7, 0, 0, 0)
    StatusLabel.Size = UDim2.new(0.3, -10, 1, 0)
    StatusLabel.Font = Enum.Font.GothamBold
    StatusLabel.Text = "OFF"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
    StatusLabel.TextSize = 13.000
    StatusLabel.TextXAlignment = Enum.TextXAlignment.Right

    ToggleButton.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            StatusLabel.Text = "ON"
            StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
        else
            StatusLabel.Text = "OFF"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
        end
        pcall(callback, enabled)
    end)
end

